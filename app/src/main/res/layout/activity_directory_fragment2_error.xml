<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_dialog_upgrade_min_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_dialog_upgrade_padding"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            android:layout_gravity="center|center_vertical"
            android:layout_margin="5px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size1"
                        android:text="Error"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:visibility="visible"
                        />
                    <!--New note-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24px"
                    >
                    <TextView
                        android:id="@+id/tvDialogMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                        android:text=""
                        android:textColor="#FF000000"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="16px"
                    android:layout_marginRight="0px"
                    >
                    <!--
                    -->
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete1"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete1"
                        android:text="Cancel"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        app:icon="@null"
                        android:id="@+id/btnCancel"
                        android:padding="0px"
                        android:textColor="#000000"
                        android:visibility="gone"
                        android:layout_gravity="center_vertical"
                        />
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete1"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete1"
                        android:text="OK"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        android:id="@+id/btnSave"
                        android:paddingLeft="0px"
                        android:paddingRight="0px"
                        android:paddingTop="0px"
                        android:paddingBottom="0px"
                        android:textColor="#000000"
                        android:layout_gravity="center_vertical"
                        />
                    <!--app:icon="@drawable/ic_outline_delete_forever_24_w"
                        -->
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
