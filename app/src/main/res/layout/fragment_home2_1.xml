<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/left_nav_bar_expand_padding"
    >
    <View
        android:layout_width="10dp"
        android:layout_height="@dimen/left_nav_bar_expand_button_item_top_height"
        />
    <androidx.cardview.widget.CardView
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/left_nav_bar_expand_button_item_height"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="10dp"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/btnTitleNewBook"
        >
        <!--
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical|center"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="10dp"
                android:background="@drawable/ic_baseline_add_24_white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New note"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:layout_gravity="center_vertical|center"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:layout_width="10dp"
        android:layout_height="@dimen/left_nav_bar_expand_button_item_bottom_height"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="5dp"
                android:id="@+id/menu_bar_item_1"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_home_001_w"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_2"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_note_002"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_3"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_book_003"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Books"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_4"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_pdf_004"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDFs"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_5"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_file_005"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_6"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_apps_006"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apps"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_nav_bar_expand_simple_item_height"
                app:cardBackgroundColor="#00888888"
                app:cardCornerRadius="@dimen/left_nav_bar_expand_simple_item_radius"
                android:layout_marginRight="@dimen/left_nav_bar_expand_simple_item_marginRight"
                android:layout_marginTop="@dimen/left_nav_bar_expand_simple_item_marginTop"
                app:cardElevation="0dp"
                android:id="@+id/menu_bar_item_7"
                android:clickable="true"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="20dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_my_nav_setting_007"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:tag="binding_5"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </ScrollView>
</LinearLayout>