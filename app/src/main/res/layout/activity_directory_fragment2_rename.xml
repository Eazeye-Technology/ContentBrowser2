<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_dialog_upgrade_min_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_dialog_upgrade_padding"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            android:layout_gravity="center|center_vertical"
            android:layout_margin="5px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size1"
                        android:text="Rename"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:visibility="visible"
                        />
                    <!--New note-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24px"
                    >
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_box_outline_no_hint"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/textState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="flagNoExtractUi"
                            android:hint="Name"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            android:lines="1"
                            android:gravity="top|left"
                            android:text=""
                            />
                        <!--
                        android:inputType="number"
                        Characteristics of Digital Electronics
                        android:hint="My first note"
                            -->
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="16px"
                    android:layout_marginRight="-10px"
                    >
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete1"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete1"
                        android:text="Cancel"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        app:icon="@null"
                        android:id="@+id/btnCancel"
                        android:padding="0px"
                        android:textColor="#000000"
                        android:layout_gravity="center_vertical"
                        />

                    <RelativeLayout
                        android:id="@+id/btnSave"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete2"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete2"
                        android:layout_gravity="center_vertical"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rename"
                            android:textColor="#000000"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="@dimen/activity_dialog_upgrade_btn_margin_left_delete2"
                            />
                    </RelativeLayout>
                    <!--
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete2"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete2"
                        android:text="Delete"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        android:id="@+id/btnSave"
                        android:paddingLeft="30px"
                        android:paddingRight="30px"
                        android:paddingTop="0px"
                        android:paddingBottom="0px"
                        android:textColor="#000000"
                        android:drawableLeft="@drawable/ic_outline_delete_forever_24_w"
                        />
                        -->
                    <!--app:icon="@drawable/ic_outline_delete_forever_24_w"
                        -->
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
