<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@android:color/transparent"
    android:descendantFocusability="blocksDescendants"
    android:id="@+id/llGridTop"
    >
<!--
格子
    android:background="@drawable/toolbar_button"
android:background="@android:color/transparent"
-->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <LinearLayout
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1px"
            android:background="@drawable/note_grid_item_list_outline"
            android:elevation="2px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center|center_vertical"
                android:padding="20px"
                >
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0px"
                    android:layout_weight="1"
                    android:layout_margin="0px"
                    android:layout_gravity="center"
                    >
                    <!--https://blog.csdn.net/qq_42618969/article/details/107863798-->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/img_item_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0px"
                        android:layout_marginBottom="0px"
                        android:layout_marginRight="0px"
                        app:cardCornerRadius="10px"
                        app:cardElevation="0px">
                        <ImageView
                            android:id="@+id/browserItemIcon_library"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/pdf_back"
                            />
                        <!--width and height should be 80px x 100px x times
                         so 134=168*80/100
                            android:layout_width="134px"
                            android:layout_height="168px"
                         -->
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/tvSuffix"
                        android:layout_width="wrap_content"
                        android:layout_height="16px"
                        android:background="@drawable/pdf_text_back"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentBottom="true"
                        android:text="PDF"
                        android:textSize="12px"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="5px"
                        android:paddingRight="5px"
                        />
                    <!--android:textSize="8px"
                    android:layout_height="15px"
                        -->
                </RelativeLayout>
                <!--android:src="@drawable/book001"-->
                <TextView
                    android:id="@+id/bookgrid_name_library"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text=""
                    android:textSize="@dimen/page_gridview_item_tv_text_size"
                    android:gravity="left|top"
                    android:layout_marginTop="16px"
                    android:layout_marginBottom="16px"
                    android:minHeight="@dimen/page_gridview_item_tv_min_height"
                    android:textColor="#FF000000"
                    />
                <!--android:textStyle="bold"
                    -->
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>
