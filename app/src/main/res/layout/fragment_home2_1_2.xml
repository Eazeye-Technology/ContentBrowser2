                app:cardCornerRadius="@dimen/fragment_home2_1_item_cv_corner"
                android:layout_marginRight="@dimen/fragment_home2_1_item_cv_margin_right"
                android:layout_marginTop="@dimen/fragment_home2_1_item_cv_margin_top"
                app:cardElevation="@dimen/fragment_home2_1_item_cv_elevation"
                android:id="@+id/menu_bar_item_1"
                android:clickable="true"
                >
                <!--
                app:cardElevation="5px"
                -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="@dimen/fragment_home2_1_item_ll_margin_left"
                    android:layout_marginRight="@dimen/fragment_home2_1_item_ll_margin_right"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/fragment_home2_1_item_iv_width"
                        android:layout_height="@dimen/fragment_home2_1_item_iv_height"
                        android:padding="@dimen/fragment_home2_1_item_iv_padding"
                        android:background="@drawable/ic_my_nav_home_001_w"
                        android:tag="binding_1"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/fragment_home2_1_item_tv_text_size"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/fragment_home2_1_item_tv_margin_left"
                        android:tag="binding_5"
                        />
                </LinearLayout>
