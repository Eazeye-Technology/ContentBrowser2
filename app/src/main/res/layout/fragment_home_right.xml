<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="0px"
    android:paddingLeft="50dp"
    android:paddingRight="50dp"
    android:paddingTop="50dp"
    android:paddingBottom="50dp"
    >

    <LinearLayout
        android:clipToPadding="false"
        android:gravity="left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <LinearLayout
            android:layout_width="300px"
            android:layout_height="400px"
            android:orientation="vertical"
            >
            <androidx.cardview.widget.CardView
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5px"
                app:cardElevation="10px"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="300px"
                    android:layout_height="400px"
                    android:padding="5px"
                    android:src="@drawable/book001"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="30dp"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continue reading"
                android:layout_marginTop="10px"
                android:layout_marginLeft="10px"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 6 — Street signs and breadcrumbs"
                android:textStyle="bold"
                android:layout_marginTop="0px"
                android:layout_marginLeft="10px"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/glyphicons_55_clock"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 hours ago"
                    android:layout_gravity="center|center_vertical"
                    />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/notificationProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@id/notificationTitle"
                android:layout_alignParentRight="true"
                android:layout_alignTop="@id/notificationPercent"
                android:layout_below="@id/notificationTitle"
                android:paddingLeft="6dp"
                android:paddingRight="3dp"
                android:paddingTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page 148 of 216"
                />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                >
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    >
                    <!--
                    android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin_left"
                    -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F6F3F2"
                        app:cardCornerRadius="@dimen/activity_dialog_upgrade_text_size1"
                        android:layout_gravity="center|center_vertical"
                        android:layout_marginLeft="10px"
                        android:id="@+id/startDiarization"
                        android:visibility="visible"
                        android:layout_centerInParent="true"
                        app:cardElevation="0px"
                        android:foreground="?android:attr/selectableItemBackground"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="0px"
                            android:background="@drawable/border_background_dark"
                            android:id="@+id/llStartDiarizationOuter"
                            >
                            <TextView
                                android:id="@+id/tvStartDiarization"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                                android:textColor="#ffffff"
                                android:textStyle="bold"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_margin="@dimen/activity_dialog_upgrade_text_size2"
                                android:visibility="visible"
                                android:text="Resume"
                                />
                            <!--
                            android:text="Start speaker diarization"
                                -->
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
            </RelativeLayout>

        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:clipToPadding="false"
            android:gravity="left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15px"
            android:visibility="visible"
            android:layout_centerVertical="true"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue working"
                android:layout_gravity="center_vertical"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recently opened notes"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:padding="40dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open notes"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                />
        </RelativeLayout>

    </RelativeLayout>





    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <GridView
            android:id="@+id/bookgridview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:paddingLeft="1px"
            android:paddingRight="1px"
            android:gravity="center"
            android:stretchMode="columnWidth"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/llEmpty1"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center"
            >
            <com.google.android.material.loadingindicator.LoadingIndicator
                style="@style/Widget.Material3.LoadingIndicator.Contained"
                android:id="@+id/progressLoading1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:containerColor="#00000000"
                />
            <!--3px, 36px, #566da9-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/loadingContent1"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:visibility="gone"
                >
                <ImageView
                    android:id="@+id/ivEmpty1"
                    android:src="@drawable/ic_baseline_folder_copy_24"
                    android:layout_width="300px"
                    android:layout_height="300px"
                    android:layout_marginBottom="10px"
                    />
                <TextView
                    android:id="@+id/tvEmpty1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:text="Nothing here yet"
                    android:textSize="32px"
                    />
                <TextView
                    android:id="@+id/tvEmpty2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:textSize="24px"
                    android:text="This space is empty. Add files to get started—drag and drop files, upload from device, or create a new one."
                    android:gravity="center"
                    android:layout_marginTop="10px"
                    />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>