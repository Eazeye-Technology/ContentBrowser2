<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0px"
        android:background="#F1EDEC"
        >
        <!--#f6f3f2-->
        <!--@color/colorBackground-->
        <!--tools:context=".MainActivity"-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64px"
            android:orientation="horizontal"
            android:layout_margin="0px"
            android:gravity="center_vertical"
            android:id="@+id/llTab"
            >

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="left"
                android:layout_gravity="center_vertical|center"
                >
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:padding="0px"
                    android:id="@+id/top_left_menu_button"
                    >
                    <androidx.cardview.widget.CardView
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="true"
                        android:layout_width="40px"
                        android:layout_height="40px"
                        app:cardCornerRadius="25px"
                        app:cardElevation="0px"
                        app:cardBackgroundColor="#00000000"
                        android:layout_centerInParent="true"
                        >
                    <RelativeLayout
                        android:layout_width="40px"
                        android:layout_height="40px">
                            <ImageView
                                android:layout_width="20px"
                                android:layout_height="20px"
                                android:layout_centerVertical="true"
                                android:layout_centerHorizontal="true"
                                android:src="@drawable/ic_baseline_menu_open_24"
                                android:id="@+id/top_left_menu_button_icon"
                                />
                    </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textSize="22px"
                        android:textColor="#000000"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tvTitleText"
                        android:layout_centerVertical="true"
                        android:visibility="visible"
                        />
                    <!--
                    android:textStyle="bold"
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/ll_search_wx_global"
                        android:gravity="center_vertical"
                        android:layout_centerVertical="true"
                        android:visibility="gone"
                        >
                        <!--EditText-->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0px"
                            android:layout_height="48px"
                            android:layout_weight="1"
                            app:cardCornerRadius="24px"
                            app:cardElevation="0px"
                            app:cardBackgroundColor="#FFFFFF"
                            >
                            <AutoCompleteTextView
                                android:gravity="left|center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textSize="16px"
                                android:textColor="#000000"
                                android:background="@null"
                                android:id="@+id/filterLine_Library_global"
                                android:maxLines="1"
                                android:hint="Search"
                                android:layout_marginLeft="16px"
                                android:layout_gravity="left|center_vertical"
                                android:paddingLeft="16px"
                                android:singleLine="true"
                                android:lines="1"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                />
                            <!--android:imeOptions="actionSend"
                                -->
                        </androidx.cardview.widget.CardView>
<!--                        <com.google.android.material.search.SearchView-->
<!--                            android:hint="Search"-->
<!--                            android:id="@+id/filterLine_Library_global__"-->
<!--                            android:gravity="top"-->
<!--                            android:layout_width="0px"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_weight="1"-->
<!--                            android:layout_marginLeft="10px"-->
<!--                            android:backgroundTint="?attr/colorSurface"-->
<!--                            />-->

                        <ImageView
                            android:layout_width="12px"
                            android:layout_height="12px"
                            android:id="@+id/iv_search_wx"
                            android:src="@drawable/serch"
                            android:layout_marginRight="10px"
                            android:layout_gravity="center_vertical"
                            android:visibility="gone"
                            />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10px"
                android:id="@+id/spaceVertical"
                android:visibility="gone"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="right"
                >

                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:padding="0px"
                    android:layout_gravity="center_vertical|center"
                    >
                    <androidx.cardview.widget.CardView
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="40px"
                        android:layout_height="40px"
                        app:cardCornerRadius="25px"
                        app:cardElevation="0px"
                        app:cardBackgroundColor="#00000000"
                        android:id="@+id/btnSearch"
                        android:layout_centerInParent="true"
                        >
                        <RelativeLayout
                            android:layout_width="40px"
                            android:layout_height="40px">

                            <ImageView
                                android:layout_width="20px"
                                android:layout_height="20px"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_baseline_search_24" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>


                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:padding="0px"
                    android:id="@+id/ll_btnMore"
                    android:visibility="visible"
                    android:layout_gravity="center|center_vertical"
                    >

                    <androidx.cardview.widget.CardView
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="40px"
                        android:layout_height="40px"
                        app:cardCornerRadius="24px"
                        app:cardElevation="0px"
                        app:cardBackgroundColor="#00000000"
                        android:id="@+id/btnMore"
                        android:layout_centerInParent="true"
                        >
                    <RelativeLayout
                        android:layout_width="40px"
                        android:layout_height="40px">
                        <ImageView
                            android:layout_width="20px"
                            android:layout_height="20px"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_baseline_more_vert_24"
                            />
                    </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:orientation="horizontal"
            android:layout_weight="1"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:id="@+id/left_menu"
                >
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0px">
                    <LinearLayout
                        android:layout_width="260px"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:id="@+id/leftmenu1"
                        >

                        <include layout="@layout/fragment_home2_1"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="96px"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:id="@+id/leftmenu2"
                        android:visibility="gone"
                        >

                        <include layout="@layout/fragment_home2_2"/>


                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/content_layout"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
