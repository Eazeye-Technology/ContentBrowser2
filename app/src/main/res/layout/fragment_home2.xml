<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0dp"
        android:background="#f6f3f2"
        >
        <!--@color/colorBackground-->
        <!--tools:context=".MainActivity"-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="0dp"
            android:gravity="center_vertical"
            android:id="@+id/llTab"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="left"
                >
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    android:id="@+id/top_left_menu_button"
                    >

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_baseline_menu_24"
                        />

                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvTitleText"
                    />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:id="@+id/spaceVertical"
                android:visibility="gone"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="right"
                >

                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    >

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_baseline_search_24"
                        />

                </RelativeLayout>


                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    >

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_baseline_more_vert_24"
                        />

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            >
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:id="@+id/left_menu"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        >

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="#000000"
                            app:cardCornerRadius="10dp"
                            android:clickable="true"
                            android:id="@+id/btnTitleNewBook"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center_vertical|center"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:padding="10dp"
                                    android:background="@drawable/ic_baseline_add_24_white"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="New note"
                                    android:textColor="#ffffff"
                                    android:textSize="14sp"
                                    android:layout_gravity="center_vertical|center"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            />
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                >
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#888888"
                                    app:cardCornerRadius="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="10dp"
                                    app:cardElevation="5dp"
                                    android:id="@+id/menu_bar_item_1"
                                    android:clickable="true"
                                    >
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical|center"
                                        >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:padding="10dp"
                                            android:background="@drawable/ic_baseline_access_time_24_white"
                                            android:tag="binding_1"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Recent"
                                            android:textColor="#ffffff"
                                            android:textSize="14sp"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginLeft="5dp"
                                            android:tag="binding_5"
                                            />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#00888888"
                                    app:cardCornerRadius="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="10dp"
                                    app:cardElevation="0dp"
                                    android:id="@+id/menu_bar_item_2"
                                    android:clickable="true"
                                    >
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical|center"
                                        >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:padding="10dp"
                                            android:background="@drawable/ic_outline_sticky_note_2_24"
                                            android:tag="binding_1"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Notes"
                                            android:textColor="#000000"
                                            android:textSize="14sp"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginLeft="5dp"
                                            android:tag="binding_5"
                                            />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#00888888"
                                    app:cardCornerRadius="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="10dp"
                                    app:cardElevation="0dp"
                                    android:id="@+id/menu_bar_item_3"
                                    android:clickable="true"
                                    >
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical|center"
                                        >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:padding="10dp"
                                            android:background="@drawable/ic_baseline_book_24"
                                            android:tag="binding_1"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Books"
                                            android:textColor="#000000"
                                            android:textSize="14sp"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginLeft="5dp"
                                            android:tag="binding_5"
                                            />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#00888888"
                                    app:cardCornerRadius="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="10dp"
                                    app:cardElevation="0dp"
                                    android:id="@+id/menu_bar_item_4"
                                    android:clickable="true"
                                    >
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical|center"
                                        >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:padding="10dp"
                                            android:background="@drawable/ic_baseline_picture_as_pdf_24"
                                            android:tag="binding_1"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="PDFs"
                                            android:textColor="#000000"
                                            android:textSize="14sp"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginLeft="5dp"
                                            android:tag="binding_5"
                                            />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#00888888"
                                    app:cardCornerRadius="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="10dp"
                                    app:cardElevation="0dp"
                                    android:id="@+id/menu_bar_item_5"
                                    android:clickable="true"
                                    >
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical|center"
                                        >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:padding="10dp"
                                            android:background="@drawable/ic_baseline_phone_android_24"
                                            android:tag="binding_1"
                                            />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Paper 2"
                                            android:textColor="#000000"
                                            android:textSize="14sp"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginLeft="5dp"
                                            android:tag="binding_5"
                                            />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>


                            </LinearLayout>
                        </ScrollView>


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/content_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
