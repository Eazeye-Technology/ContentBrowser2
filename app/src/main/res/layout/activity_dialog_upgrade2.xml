<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_dialog_upgrade_min_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_dialog_upgrade_padding"
    android:background="#474646"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            android:layout_gravity="center|center_vertical"
            android:layout_margin="5px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size1"
                        android:text="Software update available"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:visibility="visible"
                        />
                    <!--New note-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24px"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                        android:text="Download and install the newest version. We recommend downloading updates via Wi-Fi due to the large file size."
                        android:textColor="#FFFFFF"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24px"
                    >
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="right"
                            >
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                                android:text="Current version"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                                android:text="v1.0"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                />
                        </LinearLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        >
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/glyphicons_177_forward"
                            android:layout_centerInParent="true"
                            />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="left"
                            >
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                                android:text="Current version"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                                android:text="v1.2"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    >
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|center"
                        android:layout_marginTop="10dp"
                        android:layout_centerInParent="true"
                        >
                        <!--
                        android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin_left"
                        -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#F6F3F2"
                            app:cardCornerRadius="@dimen/activity_dialog_upgrade_text_size1"
                            android:layout_gravity="center|center_vertical"
                            android:layout_marginLeft="10px"
                            android:id="@+id/startDiarization"
                            android:visibility="visible"
                            android:layout_centerInParent="true"
                            app:cardElevation="0px"
                            android:foreground="?android:attr/selectableItemBackground"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="0px"
                                android:background="@drawable/border_background_gray"
                                android:id="@+id/llStartDiarizationOuter"
                                >
                                <TextView
                                    android:id="@+id/tvStartDiarization"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                                    android:textColor="#000000"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_margin="@dimen/activity_dialog_upgrade_text_size2"
                                    android:visibility="visible"
                                    android:text="Update now"
                                    />
                                <!--
                                android:text="Start speaker diarization"
                                    -->
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>
                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="16px"
                    android:layout_marginRight="-10px"
                    >

                    <RelativeLayout
                        android:id="@+id/btnSave"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_download"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_download"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone"
                        >
                        <ImageView
                            android:id="@+id/tvBtnSave2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_my_if_download"
                            android:layout_centerVertical="true"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Download"
                            android:textColor="#000000"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                            android:layout_centerVertical="true"
                            android:layout_toRightOf="@id/tvBtnSave2"
                            android:layout_marginLeft="@dimen/activity_dialog_upgrade_btn_margin_left_delete2"
                            />
                    </RelativeLayout>
                    <!--
                    <Button
                        android:id="@+id/btnSave"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_download"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_download"
                        android:drawableLeft="@drawable/ic_my_if_download"
                        android:paddingLeft="30px"
                        android:paddingTop="0px"
                        android:paddingRight="30px"
                        android:paddingBottom="0px"
                        android:text="Download"
                        android:textColor="#000000"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3" />
                        -->
                    <!--app:icon="@drawable/ic_outline_delete_forever_24_w"
                        -->
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
