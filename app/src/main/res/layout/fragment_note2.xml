<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
<!--
android:background="#f6f3f2"
-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10px"
        android:visibility="gone"
        >

        <ImageView
            android:layout_width="30px"
            android:layout_height="30px"
            android:src="@drawable/home_note_vector"
            />
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:layout_marginLeft="20px"
            />

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="right"
            >
            <!--
            <AutoCompleteTextView
                android:id="@+id/filterLine_Library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Search"
                android:layout_gravity="right"
                />
                -->

            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/rl_content_wx"
                android:layout_marginLeft="50px"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/ll_search_wx"
                    android:gravity="center_vertical"
                    android:layout_toLeftOf="@+id/iv_right"
                    android:background="@drawable/bg_search_edit2"
                    android:padding="5px"
                    >
                    <AutoCompleteTextView
                        android:gravity="top"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16px"
                        android:textColor="#cccccc"
                        android:background="@null"
                        android:id="@+id/filterLine_Library"
                        android:maxLines="1"
                        android:hint="Search"
                        android:layout_marginLeft="10px"
                        />

                    <ImageView
                        android:layout_width="12px"
                        android:layout_height="12px"
                        android:id="@+id/iv_search_wx"
                        android:src="@drawable/serch"
                        android:layout_marginRight="10px"
                        android:layout_gravity="center_vertical"
                        />
                </LinearLayout>

                <ImageView
                    android:layout_width="24px"
                    android:layout_height="24px"
                    android:layout_alignParentRight="true"
                    android:id="@+id/iv_right"
                    android:src="@mipmap/ic_launcher"
                    android:visibility="gone"
                    />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="#66CD00"
                    android:layout_below="@+id/ll_search_wx"
                    android:layout_marginTop="3px"
                    android:visibility="gone"
                    />

            </RelativeLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonNewBook"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:background="@drawable/toolbar_button"
            android:gravity="center"
            android:paddingLeft="5px"
            android:paddingRight="5px"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_add_24"
            android:text="NEW BOOK"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="11px" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0px"
        >
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tvg.AutoWrapViewGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/autoWrapViewGroup"
                android:layout_marginTop="24px"
                android:layout_marginBottom="24px"
                android:layout_marginLeft="10px"
                android:layout_marginRight="10px"
                />
        </HorizontalScrollView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1"
        >
        <GridView
            android:id="@+id/notegridview_note"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:paddingLeft="0px"
            android:paddingRight="0px"
            android:gravity="center"
            android:stretchMode="columnWidth"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/llEmpty1"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center"
            >
            <com.google.android.material.loadingindicator.LoadingIndicator
                style="@style/Widget.Material3.LoadingIndicator.Contained"
                android:id="@+id/progressLoading1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:containerColor="#00000000"
                />
            <!--3px, 36px, #566da9-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/loadingContent1"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:visibility="gone"
                >
                <ImageView
                    android:id="@+id/ivEmpty1"
                    android:src="@drawable/ic_baseline_folder_copy_24"
                    android:layout_width="300px"
                    android:layout_height="300px"
                    android:layout_marginBottom="10px"
                    />
                <TextView
                    android:id="@+id/tvEmpty1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:text="Nothing here yet"
                    android:textSize="32px"
                    />
                <TextView
                    android:id="@+id/tvEmpty2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:textSize="24px"
                    android:text="This space is empty. Add files to get started—drag and drop files, upload from device, or create a new one."
                    android:gravity="center"
                    android:layout_marginTop="10px"
                    />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/colorLightGrey"
        android:layout_margin="10px"
        android:visibility="gone"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:layout_marginLeft="10px"
        android:layout_marginRight="10px"
        android:visibility="gone"
        >
        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="0px"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintBottom_toTopOf="@id/button_first"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
<!--Page 1 of 3-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" &lt;&gt; "
            android:visibility="gone"
            />
    </LinearLayout>
</LinearLayout>