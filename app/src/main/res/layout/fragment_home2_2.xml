<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/left_nav_bar_collapse_padding"
    >
    <View
        android:layout_width="10dp"
        android:layout_height="@dimen/left_nav_bar_collapse_button_item_top_height"
        />
    <androidx.cardview.widget.CardView
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/left_nav_bar_collapse_button_item_height"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="10dp"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/btnTitleNewBook_R"
        android:visibility="visible"
        >
        <!--
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical|center"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="10dp"
                android:background="@drawable/ic_baseline_add_24_white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:layout_gravity="center_vertical|center"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:layout_width="10dp"
        android:layout_height="@dimen/left_nav_bar_collapse_button_item_bottom_height"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
