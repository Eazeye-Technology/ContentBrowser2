                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/left_nav_bar_collapse_simple_item_height"
                    app:cardBackgroundColor="#888888"
                    app:cardCornerRadius="@dimen/left_nav_bar_collapse_simple_item_radius"
                    android:layout_marginTop="@dimen/left_nav_bar_collapse_simple_item_marginTop"
                    app:cardElevation="5dp"
                    android:clickable="false"
                    android:tag="binding_0"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|center"
                        android:gravity="center"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:padding="10dp"
                            android:background="@drawable/ic_baseline_home_24_white"
                            android:tag="binding_1"
                            />
