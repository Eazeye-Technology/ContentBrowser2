<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <!--android:padding="@dimen/fragment_home2_2_linearlayout_padding"
    -->
<!--    <View-->
<!--        android:layout_width="@dimen/fragment_home2_2_view_height"-->
<!--        android:layout_height="@dimen/fragment_home2_2_view_height"-->
<!--        />-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/menu_bar_item_1_R"
                >
                <androidx.cardview.widget.CardView
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fragment_home2_2_item_cv_height"
                    app:cardBackgroundColor="#888888"
                    app:cardCornerRadius="@dimen/fragment_home2_2_item_cv_corner"
                    android:layout_marginTop="@dimen/fragment_home2_2_item_cv_margin_top"
                    app:cardElevation="@dimen/fragment_home2_2_item_cv_elevation"
                    android:clickable="false"
                    android:tag="binding_0"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|center"
                        android:gravity="center"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/fragment_home2_2_item_iv_width"
                            android:layout_height="@dimen/fragment_home2_2_item_iv_height"
                            android:padding="@dimen/fragment_home2_2_item_iv_padding"
                            android:background="@drawable/ic_baseline_home_24_white"
                            android:tag="binding_1"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#000000"
                    android:textSize="@dimen/fragment_home2_2_item_tv_text_size"
                    android:layout_gravity="center_vertical|center"
                    android:tag="binding_5"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/menu_bar_item_2_R"
                android:layout_marginTop="50dp"
                >
                <androidx.cardview.widget.CardView
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fragment_home2_2_item_cv_height"
                    app:cardBackgroundColor="#00888888"
                    app:cardCornerRadius="@dimen/fragment_home2_2_item_cv_corner"
                    android:layout_marginTop="@dimen/fragment_home2_2_item_cv_margin_top"
                    app:cardElevation="@dimen/fragment_home2_2_item_cv_elevation2"
                    android:clickable="false"
                    android:tag="binding_0"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|center"
                        android:gravity="center"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/fragment_home2_2_item_iv_width"
                            android:layout_height="@dimen/fragment_home2_2_item_iv_height"
                            android:padding="@dimen/fragment_home2_2_item_iv_padding"
                            android:background="@drawable/ic_outline_sticky_note_2_24"
                            android:tag="binding_1"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textColor="#000000"
                    android:textSize="@dimen/fragment_home2_2_item_tv_text_size"
                    android:layout_gravity="center|center_vertical"
                    android:tag="binding_5"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/menu_bar_item_6_R"
                android:layout_marginTop="50dp"
                >
                <androidx.cardview.widget.CardView
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fragment_home2_2_item_cv_height"
                    app:cardBackgroundColor="#00888888"
                    app:cardCornerRadius="@dimen/fragment_home2_2_item_cv_corner"
                    android:layout_marginTop="@dimen/fragment_home2_2_item_cv_margin_top"
                    app:cardElevation="@dimen/fragment_home2_2_item_cv_elevation2"
                    android:clickable="false"
                    android:tag="binding_0"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|center"
                        android:gravity="center"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/fragment_home2_2_item_iv_width"
                            android:layout_height="@dimen/fragment_home2_2_item_iv_height"
                            android:padding="@dimen/fragment_home2_2_item_iv_padding"
                            android:background="@drawable/ic_sharp_apps_24"
                            android:tag="binding_1"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps"
                    android:textColor="#000000"
                    android:textSize="@dimen/fragment_home2_2_item_tv_text_size"
                    android:layout_gravity="center_vertical|center"
                    android:tag="binding_5"
                    />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>