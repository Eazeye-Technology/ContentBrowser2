<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5px"
    android:background="@android:color/transparent"
    android:descendantFocusability="blocksDescendants"
    >
<!--
@android:color/transparent
    android:background="@drawable/toolbar_button"
android:background="@android:color/transparent"
-->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <!--
        androidx.cardview.widget.CardView, LinearLayout
        android:foreground="?android:attr/selectableItemBackground"
        SystemSettings
        -->
        <LinearLayout
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10px"
            android:background="@drawable/note_grid_item_list_outline"
            >
            <!--
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="20px"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="0px"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    >
                    <!--https://blog.csdn.net/qq_42618969/article/details/107863798-->
<!--                    <androidx.cardview.widget.CardView-->
<!--                        android:id="@+id/img_item_card"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginTop="0px"-->
<!--                        android:layout_marginBottom="0px"-->
<!--                        android:layout_marginRight="0px"-->
<!--                        app:cardCornerRadius="10px"-->
<!--                        app:cardElevation="0px">-->
<!--                    </androidx.cardview.widget.CardView>-->
                    <!--browserItemIcon_library-->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/browserItemIcon_library"
                            android:layout_width="30px"
                            android:layout_height="30px"
                            android:padding="0px"
                            android:scaleType="fitXY"
                            />
                        <!--width and height should be 80px x 100px x times
                         so 134=168*80/100
                         -->
                    <TextView
                        android:id="@+id/tvSuffix"
                        android:layout_width="wrap_content"
                        android:layout_height="15px"
                        android:background="@drawable/pdf_text_back"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentBottom="true"
                        android:text="PDF"
                        android:textSize="8px"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="10px"
                        android:paddingRight="10px"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        />
                </LinearLayout>
                <!--android:src="@drawable/book001"-->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="not used"
                            android:layout_marginTop="5px"
                            android:textSize="18px"
                            android:gravity="left|bottom"
                            android:textColor="#1C1C1C"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="not used"
                            android:layout_marginBottom="5px"
                            android:textSize="16px"
                            android:gravity="left|top"
                            android:textColor="#444"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="20px"
                        android:layout_gravity="center_vertical|left"
                        >
                        <TextView
                            android:id="@+id/bookgrid_name_library"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="title1"
                            android:layout_marginTop="0px"
                            android:textSize="18px"
                            android:gravity="left|top"
                            android:textColor="#1C1C1C"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                        <TextView
                            android:id="@+id/bookgrid_name_library2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="title2"
                            android:layout_marginBottom="5px"
                            android:textSize="16px"
                            android:gravity="left|center"
                            android:textColor="#444"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>
