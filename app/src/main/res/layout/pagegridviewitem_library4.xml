<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="3dp"
    android:background="@android:color/transparent"
    android:descendantFocusability="blocksDescendants"
    >
<!--
@android:color/transparent
    android:background="@drawable/toolbar_button"
android:background="@android:color/transparent"
-->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <!--
        androidx.cardview.widget.CardView, LinearLayout
        android:foreground="?android:attr/selectableItemBackground"
        SystemSettings
        -->
        <LinearLayout
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/note_grid_item_list_outline"
            >
            <!--
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="13dp"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="0px"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    >
                    <!--https://blog.csdn.net/qq_42618969/article/details/107863798-->
<!--                    <androidx.cardview.widget.CardView-->
<!--                        android:id="@+id/img_item_card"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginTop="0px"-->
<!--                        android:layout_marginBottom="0px"-->
<!--                        android:layout_marginRight="0px"-->
<!--                        app:cardCornerRadius="10px"-->
<!--                        app:cardElevation="0px">-->
<!--                    </androidx.cardview.widget.CardView>-->
                    <!--browserItemIcon_library-->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/browserItemIcon_library"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:padding="0dp"
                            android:scaleType="fitXY"
                            android:tint="@color/md_theme_onSurfaceVariant_highContrast"
                            />
                        <!--width and height should be 80px x 100px x times
                         so 134=168*80/100
                         -->
                    <TextView
                        android:id="@+id/tvSuffix"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:background="@drawable/pdf_text_back"
                        android:text="PDF"
                        android:textSize="5sp"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        />
                </LinearLayout>
                <!--android:src="@drawable/book001"-->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="not used"
                            android:layout_marginTop="3dp"
                            android:textSize="16sp"
                            android:gravity="start|bottom"
                            android:textColor="@color/md_theme_onSurface_highContrast"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="not used"
                            android:layout_marginBottom="3dp"
                            android:textSize="14sp"
                            android:gravity="start|top"
                            android:textColor="@color/md_theme_onSurfaceVariant_highContrast"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp"
                        android:layout_gravity="center_vertical|start"
                        >
                        <TextView
                            android:id="@+id/bookgrid_name_library"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="title1"
                            android:layout_marginTop="0dp"
                            android:textSize="16sp"
                            android:gravity="start|top"
                            android:textColor="@color/md_theme_onSurface_highContrast"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                        <TextView
                            android:id="@+id/bookgrid_name_library2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="title2"
                            android:layout_marginBottom="3dp"
                            android:textSize="14sp"
                            android:gravity="start|center"
                            android:textColor="@color/md_theme_onSurfaceVariant_highContrast"
                            android:lines="1"
                            android:ellipsize="end"
                            />
                        <!--android:textStyle="bold"
                            -->
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:enabled="true"
                    android:text=""
                    android:id="@+id/switchOpen"
                    android:visibility="gone"
                    style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                    app:thumbStrokeColor="#000000"
                    />
                <!--
                app:thumbTint="@color/primary"
    app:trackTint="@color/track_color"
    app:thumbStrokeColor="@color/stroke_color"
    app:switchMinWidth="60dp"
    -->
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>
