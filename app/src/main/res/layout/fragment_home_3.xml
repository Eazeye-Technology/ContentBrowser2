<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/cat_navigation_rail_expand_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_drawer_menu_24px"
            android:contentDescription="@string/cat_navigation_rail_expand_button_description"
            android:scaleType="center" />
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="24sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvTitleText"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/ll_search_wx_global"
                android:gravity="center_vertical"
                android:layout_centerVertical="true"
                android:visibility="gone"
                >
                <AutoCompleteTextView
                    android:gravity="top"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="#cccccc"
                    android:background="@null"
                    android:id="@+id/filterLine_Library"
                    android:maxLines="1"
                    android:hint="Search"
                    android:layout_marginLeft="10dp"
                    />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/iv_search_wx"
                    android:src="@drawable/serch"
                    android:layout_marginRight="10dp"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone"
                    />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="right"
            >

            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="0dp"
                >
                <androidx.cardview.widget.CardView
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    android:id="@+id/btnSearch"
                    >
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_baseline_search_24"
                            />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>


            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="0dp"
                >

                <androidx.cardview.widget.CardView
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    >
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/ic_baseline_more_vert_24"
                            />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/cat_navigation_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:menu="@menu/navigation_rail_submenus_menu3"
            android:fitsSystemWindows="false"
            app:labelVisibilityMode="labeled"
            app:scrollingEnabled="true"
            app:expandedItemMinHeight="80dp"
            app:itemPaddingTop="25dp"
            app:itemPaddingBottom="25dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            app:itemIconSize="35dp"
            app:itemTextAppearanceActive="@style/TextAppearance.my2"
            app:itemTextAppearanceInactive="@style/TextAppearance.my2"
            app:itemTextAppearanceActiveBoldEnabled="@style/TextAppearance.my"
            app:horizontalItemTextAppearanceActive="@style/TextAppearance.my"
            app:horizontalItemTextAppearanceInactive="@style/TextAppearance.my"
            app:itemSpacing="0dp"
            />

        <!--
            app:labelVisibilityMode="labeled"
            app:scrollingEnabled="true"
            app:submenuDividersEnabled="true"
            app:layout_constraintStart_toStartOf="parent"
    -->


        <FrameLayout
            android:id="@+id/content_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            />

<!--        <FrameLayout-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="match_parent"-->
<!--            app:layout_constraintStart_toEndOf="@id/cat_navigation_rail"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            />-->
    </LinearLayout>
</LinearLayout>
