<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:layout_width="300px"
            android:layout_height="wrap_content"
            android:layout_marginTop="50px"
            android:layout_marginLeft="50px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|center_vertical"
                android:background="@drawable/menu_outline"
                android:elevation="10px"
                >
                <!--
                app:cardBackgroundColor="#F1EDEC"
                app:cardCornerRadius="10px"
                app:cardElevation="1px"
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10px"
                    >
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#00585858"
                        app:cardCornerRadius="30px"
                        app:cardElevation="0px"
                        android:layout_gravity="center|center_vertical"
                        android:layout_margin="5px"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="0px"
                                    android:layout_weight="0"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_content_cut_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:visibility="visible"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Open"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="0px"
                                    android:layout_weight="0"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_content_cut_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:visibility="visible"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Open with..."
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2px"
                                android:background="#000000"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="40px"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_library_books_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Copy"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="40px"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_content_paste_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Paste"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="40px"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_content_cut_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Cut"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2px"
                                android:background="#000000"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="40px"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_summarize_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:visibility="visible"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18px"
                                    android:text="Summarize"
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>


                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2px"
                                android:background="#000000"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="1px"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                android:layout_marginBottom="10px"
                                >
                                <ImageView
                                    android:layout_width="40px"
                                    android:layout_height="40px"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:paddingLeft="5px"
                                    android:paddingRight="5px"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_delete_outline_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:visibility="visible"
                                    />
                                <TextView
                                    android:layout_width="0px"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="18px"
                                    android:text="Delete..."
                                    android:textColor="#000000"
                                    android:layout_gravity="center"
                                    android:gravity="left"
                                    android:layout_marginLeft="10px"
                                    android:layout_marginRight="10px"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
