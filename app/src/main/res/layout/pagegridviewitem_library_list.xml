<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="20px"
    android:background="@drawable/toolbar_button"
    android:gravity="center_vertical"
    >
<!--
android:background="@android:color/transparent"
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10px"
        android:layout_gravity="center_vertical"
        >
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="200px"
            android:layout_margin="0px"
            android:layout_gravity="center"
            >
            <!--https://blog.csdn.net/qq_42618969/article/details/107863798-->
            <androidx.cardview.widget.CardView
                android:id="@+id/img_item_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0px"
                android:layout_marginBottom="0px"
                android:layout_marginRight="0px"
                app:cardCornerRadius="10px"
                app:cardElevation="0px">
                <ImageView
                    android:id="@+id/browserItemIcon_library"
                    android:layout_width="160px"
                    android:layout_height="200px"
                    android:background="@drawable/pdf_back"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tvSuffix"
                android:layout_width="wrap_content"
                android:layout_height="15px"
                android:background="@drawable/pdf_text_back"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:text="PDF"
                android:textSize="8px"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:paddingLeft="10px"
                android:paddingRight="10px"
                />
        </RelativeLayout>

        <TextView
            android:id="@+id/bookgrid_name_library"
            android:layout_width="match_parent"
            android:layout_height="@dimen/book_name_height"
            android:maxLines="2"
            android:text=""
            android:textStyle="bold"
            android:layout_marginTop="5px"
            android:textSize="10px"
            android:gravity="center"
            />
        <!--Mind, Society, and Behavior-->
    </LinearLayout>
</LinearLayout>
