<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root_layout"
    android:orientation="horizontal"
    >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0px"
        android:background="#FFFFFF"
        >
        <!--#F1EDEC-->
        <!--#f6f3f2-->
        <!--@color/colorBackground-->
        <!--tools:context=".MainActivity"-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:orientation="horizontal"
            android:layout_weight="1"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:id="@+id/left_menu"
                android:background="#F9F9F9"
                >
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0px">

                    <LinearLayout
                        android:layout_width="@dimen/fragment_home2_nav_menu_collapse_width"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:id="@+id/leftmenu2"
                        android:visibility="visible"
                        >

                        <include layout="@layout/fragment_home2_2_3"/>


                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <View
                android:background="#464A4A"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:layout_marginLeft="-2dp"
                />
            <LinearLayout
                android:layout_width="0px"
                android:layout_weight="3"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="40dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fragment_home2_title_height"
                    android:orientation="horizontal"
                    android:layout_margin="0px"
                    android:gravity="center_vertical"
                    android:id="@+id/llTab"
                    >

                    <LinearLayout
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="left"
                        android:layout_gravity="center_vertical|center"
                        >
                        <RelativeLayout
                            android:orientation="vertical"
                            android:layout_width="@dimen/fragment_home2_title_back_width"
                            android:layout_height="@dimen/fragment_home2_title_back_height"
                            android:padding="0px"
                            android:id="@+id/top_left_menu_button"
                            android:visibility="gone"
                            >
                            <androidx.cardview.widget.CardView
                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="false"
                                android:focusable="true"
                                android:layout_width="@dimen/fragment_home2_title_back_cv_width"
                                android:layout_height="@dimen/fragment_home2_title_back_cv_height"
                                app:cardCornerRadius="@dimen/fragment_home2_title_back_cv_corner"
                                app:cardElevation="0px"
                                app:cardBackgroundColor="#00000000"
                                android:layout_centerInParent="true"
                                >
                            <RelativeLayout
                                android:layout_width="@dimen/fragment_home2_title_back_rl_width"
                                android:layout_height="@dimen/fragment_home2_title_back_rl_height">
                                    <ImageView
                                        android:layout_width="@dimen/fragment_home2_title_back_rl_iv_width"
                                        android:layout_height="@dimen/fragment_home2_title_back_rl_iv_height"
                                        android:layout_centerVertical="true"
                                        android:layout_centerHorizontal="true"
                                        android:src="@drawable/ic_baseline_menu_open_24"
                                        android:id="@+id/top_left_menu_button_icon"
                                        />
                            </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home"
                                android:textSize="@dimen/fragment_home2_title_tv_text_size"
                                android:textColor="#000000"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tvTitleText"
                                android:layout_centerVertical="true"
                                android:visibility="gone"
                                />
                            <!--
                            android:textStyle="bold"
                            -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:id="@+id/ll_search_wx_global"
                                android:gravity="center_vertical"
                                android:layout_centerVertical="true"
                                android:visibility="visible"
                                >
                                <!--EditText-->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/fragment_home2_title_et_cv_height"
                                    app:cardCornerRadius="@dimen/fragment_home2_title_et_cv_corner"
                                    app:cardElevation="0px"
                                    app:cardBackgroundColor="#D7D4D3"
                                    >
                                    <!--#FFFFFF-->
                                    <AutoCompleteTextView
                                        android:gravity="left|center_vertical"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:textSize="@dimen/fragment_home2_title_et_text_size"
                                        android:textColor="#000000"
                                        android:background="@null"
                                        android:id="@+id/filterLine_Library_global"
                                        android:maxLines="1"
                                        android:hint="Search file by name"
                                        android:layout_marginLeft="@dimen/fragment_home2_title_et_margin_left"
                                        android:layout_gravity="left|center_vertical"
                                        android:paddingLeft="@dimen/fragment_home2_title_et_padding_left"
                                        android:singleLine="true"
                                        android:lines="1"
                                        android:imeOptions="actionSearch"
                                        android:inputType="textNoSuggestions"
                                        />
                                    <!--android:imeOptions="actionSend"
                                        -->
                                </androidx.cardview.widget.CardView>
                                <!--                        <com.google.android.material.search.SearchView-->
                                <!--                            android:hint="Search"-->
                                <!--                            android:id="@+id/filterLine_Library_global__"-->
                                <!--                            android:gravity="top"-->
                                <!--                            android:layout_width="0px"-->
                                <!--                            android:layout_height="wrap_content"-->
                                <!--                            android:layout_weight="1"-->
                                <!--                            android:layout_marginLeft="10px"-->
                                <!--                            android:backgroundTint="?attr/colorSurface"-->
                                <!--                            />-->

                                <ImageView
                                    android:layout_width="@dimen/fragment_home2_title_et_iv_sch_width"
                                    android:layout_height="@dimen/fragment_home2_title_et_iv_sch_height"
                                    android:id="@+id/iv_search_wx"
                                    android:src="@drawable/ic_baseline_search_24"
                                    android:layout_marginRight="@dimen/fragment_home2_title_et_iv_sch_margin_right"
                                    android:layout_gravity="center_vertical"
                                    android:visibility="visible"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    />
                                <!--android:src="@drawable/serch"
                                    -->
                            </RelativeLayout>
                        </RelativeLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fragment_home2_title_space_height"
                        android:id="@+id/spaceVertical"
                        android:visibility="gone"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="right"
                        >

                        <RelativeLayout
                            android:orientation="vertical"
                            android:layout_width="@dimen/fragment_home2_title_search_rl_width"
                            android:layout_height="@dimen/fragment_home2_title_search_rl_height"
                            android:padding="0px"
                            android:layout_gravity="center_vertical|center"
                            android:id="@+id/ll_btnSearch"
                            android:visibility="gone"
                            >
                            <androidx.cardview.widget.CardView
                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_width="@dimen/fragment_home2_title_search_rl_cv_width"
                                android:layout_height="@dimen/fragment_home2_title_search_rl_cv_height"
                                app:cardCornerRadius="@dimen/fragment_home2_title_search_rl_cv_corner"
                                app:cardElevation="0px"
                                app:cardBackgroundColor="#00000000"
                                android:id="@+id/btnSearch"
                                android:layout_centerInParent="true"
                                >
                                <RelativeLayout
                                    android:layout_width="@dimen/fragment_home2_title_search_rl_cv_rl_width"
                                    android:layout_height="@dimen/fragment_home2_title_search_rl_cv_rl_height"
                                    >
                                    <ImageView
                                        android:layout_width="@dimen/fragment_home2_title_search_rl_cv_rl_iv_width"
                                        android:layout_height="@dimen/fragment_home2_title_search_rl_cv_rl_iv_height"
                                        android:layout_centerInParent="true"
                                        android:src="@drawable/ic_baseline_search_24" />
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>


                        <RelativeLayout
                            android:orientation="vertical"
                            android:layout_width="@dimen/fragment_home2_title_search_rl_width"
                            android:layout_height="@dimen/fragment_home2_title_search_rl_height"
                            android:padding="0px"
                            android:id="@+id/ll_btnMore"
                            android:visibility="gone"
                            android:layout_gravity="center|center_vertical"
                            >

                            <androidx.cardview.widget.CardView
                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_width="@dimen/fragment_home2_title_search_rl_cv_width"
                                android:layout_height="@dimen/fragment_home2_title_search_rl_cv_height"
                                app:cardElevation="0px"
                                app:cardCornerRadius="20px"
                                app:cardBackgroundColor="#00000000"
                                android:id="@+id/btnMore"
                                android:layout_centerInParent="true"
                                >
                                <!--
                                app:cardCornerRadius="@dimen/fragment_home2_title_search_rl_cv_corner"
                                -->
                                <RelativeLayout
                                    android:layout_width="@dimen/fragment_home2_title_search_rl_cv_rl_width"
                                    android:layout_height="@dimen/fragment_home2_title_search_rl_cv_rl_height">
                                    <ImageView
                                        android:id="@+id/ivBtnMore"
                                        android:layout_width="@dimen/fragment_home2_title_search_rl_cv_rl_iv_width"
                                        android:layout_height="@dimen/fragment_home2_title_search_rl_cv_rl_iv_height"
                                        android:layout_centerInParent="true"
                                        android:src="@drawable/ic_baseline_more_vert_24"
                                        />
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/content_layout61"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
