<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300px"
    android:layout_height="wrap_content"
    android:layout_marginTop="50px"
    android:layout_marginLeft="50px"
    >
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        android:layout_gravity="center|center_vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            >
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00585858"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                android:layout_gravity="center|center_vertical"
                android:layout_margin="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_copy_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Copy"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_paste_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Paste"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Cut"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Insert image..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Rename file..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Page background..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_share_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            android:text="Share..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="left"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_arrow_right_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
